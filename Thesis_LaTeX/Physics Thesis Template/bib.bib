@incollection{WEIDMANN2021159,
title = {4 - Atmospheric trace gas measurements using laser heterodyne spectroscopy},
editor = {Weidong Chen and Dean S. Venables and Markus W. Sigrist},
booktitle = {Advances in Spectroscopic Monitoring of the Atmosphere},
publisher = {Elsevier},
pages = {159-223},
year = {2021},
isbn = {978-0-12-815014-6},
doi = {https://doi.org/10.1016/B978-0-12-815014-6.00005-1},
url = {https://www.sciencedirect.com/science/article/pii/B9780128150146000051},
author = {Damien Weidmann},
keywords = {Atmospheric remote sensing, High-resolution spectroscopy, Laser heterodyne, Middle infrared, Quantum cascade lasers},
abstract = {Laser heterodyne spectro-radiometry offers significant combined benefits for molecular remote sensing: ultrahigh spectral resolution, narrow field of view, and ideally a shot noise limited radiometric sensitivity. In conjunction with the development of photonics, compact systems leveraging these benefits can be developed for atmospheric composition sounding applications. In this chapter, principles of laser heterodyning are presented, as well as those of molecular altitudinal profiling from passive spectrometers. Examples of developments of quantum cascade laser heterodyne spectro-radiometers are given in the context of ozone and greenhouse gas sensing, among others atmospheric constituents. Miniaturized heterodyne systems are also described in the context of small satellite space missions for high accuracy atmospheric profiling. Lastly, prospective space missions exploiting the benefits of laser heterodyne spectro-radiometers are outlined.}
}

